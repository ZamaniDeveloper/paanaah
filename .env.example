PORT=3000

# Generate a long, random value for production.
JWT_SECRET=

# Optional: use Redis instead of the built-in local JSON store.
REDIS_URL=

# Optional: enable browser push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional: webhook used by the one-time-password flow.
OTP_WEBHOOK_URL=

# Optional: legacy code-based login values.
ADMIN_CODE=
CUSTOMER_CODE=

